# This repository is checked out at the agent's $HOME (/home/agent), beside
# secrets and runtime state: .ssh, .claude, .config, work/. So it ignores
# everything at the top level and re-includes only the definition files it
# tracks: a `git add -A` in $HOME can then never capture a secret or a state
# file. work/ is never tracked; onboarding and the scripts write it.

/*

!/.gitignore
!/AGENTS.md
!/CLAUDE.md
!/ONBOARDING.md
!/README.md
!/LICENSE
!/kit.yaml
!/VERSION
!/CHANGELOG.md
!/docs/
!/scripts/
!/dashboard/
!/examples/
!/.github/

__pycache__/
node_modules/
.DS_Store
