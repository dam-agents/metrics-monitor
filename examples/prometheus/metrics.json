{
  "step": 3600,
  "history_days": 90,
  "notes": [
    "Example for a vLLM serving cluster scraped by Prometheus or Mimir. Replace the job and namespace filters with your own after breaking each metric down by job and pod (docs/data-quality.md)."
  ],
  "metrics": [
    {
      "id": "output_tokens",
      "label": "Output tokens",
      "unit": "tokens",
      "kind": "sum",
      "by": "namespace",
      "query": "sum by (namespace) (increase(vllm:generation_tokens_total[$step]))",
      "description": "Tokens generated, per serving namespace"
    },
    {
      "id": "requests",
      "label": "Requests served",
      "unit": "requests",
      "kind": "sum",
      "by": "namespace",
      "query": "sum by (namespace) (increase(vllm:request_success_total[$step]))",
      "description": "Requests that finished successfully"
    },
    {
      "id": "gpu_hours",
      "label": "GPU-hours",
      "unit": "GPU-hours",
      "kind": "sum",
      "by": "namespace",
      "query": "sum by (namespace) (sum_over_time(count by (namespace) (DCGM_FI_DEV_GPU_UTIL)[$step:1m])) / 60",
      "description": "GPUs reporting × hours, time-weighted by the minute (a GPU missing for a minute counts zero for it)"
    },
    {
      "id": "gpu_busy",
      "label": "GPU busy",
      "unit": "%",
      "kind": "avg",
      "combine": "mean",
      "query": "avg(avg_over_time(DCGM_FI_DEV_GPU_UTIL[$step]))",
      "verify_query": "avg(avg_over_time(DCGM_FI_DEV_GPU_UTIL[$step]))",
      "decimals": 1,
      "description": "Average of the GPUs' own busy percentage",
      "tolerance_pct": 2
    },
    {
      "id": "ttft_p95",
      "label": "Time to first token, p95",
      "unit": "s",
      "kind": "avg",
      "combine": "mean",
      "query": "histogram_quantile(0.95, sum by (le) (increase(vllm:time_to_first_token_seconds_bucket[$step])))",
      "decimals": 2,
      "description": "95th percentile per hour, interpolated inside a histogram bucket; a longer range shows the mean of the hourly values"
    }
  ],
  "derived": [
    {
      "id": "gpu_hours_per_m_tokens",
      "label": "GPU-hours per million output tokens",
      "unit": "GPU-h/M",
      "op": "ratio",
      "a": "gpu_hours",
      "b": "output_tokens",
      "factor": 1000000
    }
  ]
}
