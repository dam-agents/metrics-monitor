{
  "step": 3600,
  "history_days": 60,
  "notes": [
    "Demo data: a synthetic online shop, generated by scripts/sources/demo.py. Replace it with a real source at onboarding."
  ],
  "metrics": [
    {
      "id": "orders",
      "label": "Orders",
      "unit": "orders",
      "kind": "sum",
      "by": "region",
      "query": "orders",
      "description": "Orders placed, per region",
      "kpi": {
        "op": ">=",
        "target": 5000,
        "per": "day",
        "set_by": "example target (demo)"
      }
    },
    {
      "id": "response_time",
      "label": "Median response time",
      "unit": "s",
      "kind": "avg",
      "combine": "mean",
      "query": "response_time",
      "verify_query": "response_time",
      "decimals": 2,
      "description": "Median time the site takes to answer a page request, hourly",
      "kpi": {
        "op": "<=",
        "target": 0.3,
        "set_by": "example target (demo)"
      }
    },
    {
      "id": "server_hours",
      "label": "Server-hours",
      "unit": "server-hours",
      "kind": "sum",
      "by": "pool",
      "query": "servers",
      "description": "Servers running × hours, time-weighted, per pool"
    },
    {
      "id": "errors",
      "label": "Error hours",
      "unit": "hours",
      "kind": "sum",
      "query": "errors",
      "description": "Hours with at least one failed checkout"
    }
  ],
  "derived": [
    {
      "id": "hosting_cost",
      "label": "Hosting cost",
      "unit": "$",
      "op": "times",
      "a": "server_hours",
      "factor": 0.4,
      "set_by": "example rate $0.40/server-hour (demo), set by hand, not measured",
      "description": "Server-hours × $0.40/server-hour"
    },
    {
      "id": "orders_per_server_hour",
      "label": "Orders per server-hour",
      "unit": "orders/server-h",
      "op": "ratio",
      "a": "orders",
      "b": "server_hours"
    }
  ]
}
