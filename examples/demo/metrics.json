{
  "step": 3600,
  "history_days": 60,
  "notes": [
    "Demo data: synthetic, generated by scripts/sources/demo.py. Replace it with a real source at onboarding."
  ],
  "metrics": [
    {
      "id": "requests",
      "label": "Requests served",
      "unit": "requests",
      "kind": "sum",
      "by": "group",
      "query": "requests",
      "description": "Requests that completed, per team",
      "kpi": {
        "op": ">=",
        "target": 15000,
        "per": "day",
        "set_by": "example target (demo)"
      }
    },
    {
      "id": "latency",
      "label": "Median latency",
      "unit": "s",
      "kind": "avg",
      "combine": "mean",
      "query": "latency",
      "verify_query": "latency",
      "description": "Median time to answer, hourly",
      "kpi": {
        "op": "<=",
        "target": 2,
        "set_by": "example target (demo)"
      }
    },
    {
      "id": "gpu_hours",
      "label": "GPU-hours",
      "unit": "GPU-hours",
      "kind": "sum",
      "by": "group",
      "query": "gpus",
      "description": "GPUs assigned \u00d7 hours, time-weighted, per pool"
    },
    {
      "id": "errors",
      "label": "Error hours",
      "unit": "hours",
      "kind": "sum",
      "query": "errors",
      "description": "Hours with at least one failed request"
    }
  ],
  "derived": [
    {
      "id": "gpu_hours_cost",
      "label": "GPU cost",
      "unit": "$",
      "op": "times",
      "a": "gpu_hours",
      "factor": 2.0,
      "set_by": "example rate $2/GPU-hour (demo), set by hand, not measured",
      "description": "GPU-hours \u00d7 $2/GPU-hour"
    },
    {
      "id": "requests_per_gpu_hour",
      "label": "Requests per GPU-hour",
      "unit": "req/GPU-h",
      "op": "ratio",
      "a": "requests",
      "b": "gpu_hours"
    }
  ]
}
