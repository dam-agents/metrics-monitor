{
  "step": 3600,
  "history_days": 60,
  "notes": [
    "Demo data: a synthetic software product, generated by scripts/sources/demo.py. Replace it with a real source at onboarding."
  ],
  "metrics": [
    {
      "id": "sessions",
      "label": "Sessions",
      "unit": "sessions",
      "kind": "sum",
      "by": "feature",
      "query": "sessions",
      "description": "User sessions, per feature used",
      "kpi": {
        "op": ">=",
        "target": 5000,
        "per": "day",
        "set_by": "example target (demo)"
      }
    },
    {
      "id": "page_load",
      "label": "Median page load",
      "unit": "s",
      "kind": "avg",
      "combine": "mean",
      "query": "page_load",
      "verify_query": "page_load",
      "decimals": 2,
      "description": "Median time a page takes to load, hourly",
      "kpi": {
        "op": "<=",
        "target": 1.5,
        "set_by": "example target (demo)"
      }
    },
    {
      "id": "signups",
      "label": "Signups",
      "unit": "users",
      "kind": "sum",
      "by": "plan",
      "query": "signups",
      "description": "New accounts, per plan"
    },
    {
      "id": "errors",
      "label": "Error hours",
      "unit": "hours",
      "kind": "sum",
      "query": "errors",
      "description": "Hours with at least one failed request"
    }
  ],
  "derived": [
    {
      "id": "new_mrr",
      "label": "New monthly revenue",
      "unit": "$",
      "op": "times",
      "a": "signups",
      "factor": 20.0,
      "set_by": "example rate $20 per signup (demo), set by hand, not measured",
      "description": "Signups \u00d7 $20 per signup"
    },
    {
      "id": "sessions_per_signup",
      "label": "Sessions per signup",
      "unit": "sessions/user",
      "op": "ratio",
      "a": "sessions",
      "b": "signups"
    }
  ]
}
